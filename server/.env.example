# Copy to server/.env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=5001

# Browser origins allowed to call the API (comma-separated)
CLIENT_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API (0 locally; 1 behind a single load balancer)
TRUST_PROXY=0

# Local MongoDB, or an Atlas SRV string (put real credentials only in your private .env)
MONGODB_URI=mongodb://127.0.0.1:27017/creatordesk

# Seconds between reconnect attempts when the DB is unreachable
DB_RETRY_SECONDS=5

# Rate limiting (global)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Authentication ---
# REQUIRED: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The placeholder below is rejected in production.
JWT_ACCESS_SECRET=change-me-generate-a-long-random-string-before-use
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to true in production (HTTPS only). Leave unset locally.
# COOKIE_SECURE=true
BCRYPT_COST=12
# Lock an account for LOCKOUT_MINUTES after this many consecutive wrong passwords
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Strict limit on failed register/login/change-password attempts per IP
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
