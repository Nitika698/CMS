# Copy to server/.env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=5001

# Browser origins allowed to call the API (comma-separated)
CLIENT_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API (0 locally; 1 behind a single load balancer)
TRUST_PROXY=0

# Local MongoDB, or an Atlas SRV string (put real credentials only in your private .env)
MONGODB_URI=mongodb://127.0.0.1:27017/cms

# Seconds between reconnect attempts when the DB is unreachable
DB_RETRY_SECONDS=5

# Rate limiting (global)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Authentication ---
# REQUIRED: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The placeholder below is rejected in production.
JWT_ACCESS_SECRET=change-me-generate-a-long-random-string-before-use
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to true in production (HTTPS only). Leave unset locally.
# COOKIE_SECURE=true
BCRYPT_COST=12
# Lock an account for LOCKOUT_MINUTES after this many consecutive wrong passwords
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Strict limit on failed register/login/change-password attempts per IP
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# --- Media storage (content assets) ---
# "local" writes to UPLOAD_DIR and is for development only (refused in production).
# "cloudinary" stores assets as private (authenticated) resources; set the three CLOUDINARY_* values below.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_IMAGE_MB=10
MAX_UPLOAD_VIDEO_MB=100
MAX_UPLOAD_DOC_MB=20
MAX_ASSETS_PER_CONTENT=20
# How long a signed asset link (used by <img>/<video> tags) stays valid
ASSET_TOKEN_TTL_SECONDS=300
UPLOAD_RATE_LIMIT_MAX=60
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Calendar (internal scheduling only) ---
# Two posts on the same platform closer together than this need an explicit "schedule anyway" confirmation
CALENDAR_CONFLICT_WINDOW_MINUTES=30
# How often the in-process reminder job runs
REMINDER_SWEEP_SECONDS=60
